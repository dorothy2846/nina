<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0-windows</TargetFrameworks>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF Condition="'$(TargetFramework)' == 'net10.0-windows'">true</UseWPF>
    <ImportWindowsDesktopTargets Condition="'$(TargetFramework)' == 'net10.0-windows'">true</ImportWindowsDesktopTargets>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Configurations>Debug;Release;SignedRelease</Configurations>
    <EnableWindowsTargeting Condition="'$(TargetFramework)' == 'net10.0-windows'">true</EnableWindowsTargeting>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSource>true</IncludeSource>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'SignedRelease|AnyCPU'">
    <OutputPath>bin\SignedRelease\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="publish\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="publish\**" />
    <Page Remove="publish\**" />
  </ItemGroup>
  <!-- Exclude WPF-only files when building for non-Windows targets -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="Utility\Converters\**" />
    <Compile Remove="Utility\ValidationRules\**" />
    <Compile Remove="Utility\ValidationRules.cs" />
    <Compile Remove="Utility\Notification\**" />
    <Compile Remove="Utility\WindowService\**" />
    <Compile Remove="Utility\TabControlEx.cs" />
    <Compile Remove="Utility\BindingProxy.cs" />
    <Compile Remove="Utility\ButtonHelper.cs" />
    <Compile Remove="Utility\DeferredContent.cs" />
    <Compile Remove="Utility\DialogCloser.cs" />
    <Compile Remove="Utility\DataPipes.cs" />
    <Compile Remove="Utility\Extensions\WPFExtensions.cs" />
    <Compile Remove="Utility\ColorSchema\ColorSchema.cs" />
    <Compile Remove="Utility\Http\HttpDownloadImageRequest.cs" />
    <Compile Remove="MyMessageBox\**" />
    <Compile Remove="Model\IImageGeometryProvider.cs" />
    <Compile Remove="Interfaces\IMyMessageBoxVM.cs" />
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Compile Remove="Utility\InvokeProcess.cs" />
    <Compile Remove="Utility\ApplicationResourceDictionary.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\CommonAssemblyInfo.cs">
      <Link>Properties\CommonAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos\API\ASCOM\Camera\CameraService.proto" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Accord.Math" Version="3.8.2-alpha" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf">
      <Version>3.33.4</Version>
    </PackageReference>
    <PackageReference Include="Google.Protobuf.Tools">
      <Version>3.33.4</Version>
    </PackageReference>
    <PackageReference Include="Grpc.Core.Api">
      <Version>2.76.0</Version>
    </PackageReference>
    <PackageReference Include="Grpc.Tools">
      <Version>2.76.0</Version>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json">
      <Version>13.0.4</Version>
    </PackageReference>
    <PackageReference Include="OxyPlot.Core">
      <Version>2.2.0</Version>
    </PackageReference>
    <PackageReference Include="Serilog.Sinks.Console">
      <Version>6.1.1</Version>
    </PackageReference>
    <PackageReference Include="Serilog.Sinks.File">
      <Version>7.0.0</Version>
    </PackageReference>
    <PackageReference Include="SourceGear.sqlite3" Version="3.50.4.5" />
    <PackageReference Include="System.ComponentModel.Composition" Version="10.0.2" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
    <PackageReference Include="System.Data.SQLite">
      <Version>2.0.2</Version>
    </PackageReference>
    <PackageReference Include="System.Data.SQLite.EF6" Version="2.0.2" />
    <PackageReference Include="System.IO.Ports" Version="10.0.2" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.Runtime.Caching" Version="10.0.2" />
  </ItemGroup>
  <ItemGroup>
    <Resource Condition="'$(TargetFramework)' == 'net10.0-windows'" Include="Resources\Logo_Nina.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="Locale\Locale.ar-SA.resx" />
    <EmbeddedResource Remove="Locale\Locale.sv-SE.resx" />
  </ItemGroup>
  <PropertyGroup>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>N.I.N.A. Core Library</Title>
    <Version>3.3.0.1016-nightly</Version>
    <Authors>Stefan Berg and the N.I.N.A. Contributors</Authors>
    <Product>N.I.N.A. - Nighttime Imaging 'N' Astronomy</Product>
    <Description>This assembly contains the core components of N.I.N.A.</Description>
    <Copyright>Copyright ©  2016 - 2026 Stefan Berg and the N.I.N.A. contributors</Copyright>
    <PackageProjectUrl>https://nighttime-imaging.eu/</PackageProjectUrl>
    <PackageIcon>ninasplash.png</PackageIcon>
    <RepositoryUrl>https://github.com/isbeorn/nina.git</RepositoryUrl>
    <PackageOutputPath>$(SolutionDir)publish</PackageOutputPath>
    <IncludeSymbols>False</IncludeSymbols>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\NINA\Resources\ninasplash.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Locale\Locale.resx">
      <Generator>
      </Generator>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Interfaces\Utility\" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec IgnoreExitCode="true" Command="if $(Configuration) == SignedRelease signtool sign /t http://timestamp.sectigo.com /i Sectigo /v /a /fd SHA256 $(TargetPath)" />
  </Target>
</Project>