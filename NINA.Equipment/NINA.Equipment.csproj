<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0-windows</TargetFrameworks>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF Condition="'$(TargetFramework)' == 'net10.0-windows'">true</UseWPF>
    <ImportWindowsDesktopTargets Condition="'$(TargetFramework)' == 'net10.0-windows'">true</ImportWindowsDesktopTargets>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Configurations>Debug;Release;SignedRelease</Configurations>
    <EnableWindowsTargeting Condition="'$(TargetFramework)' == 'net10.0-windows'">true</EnableWindowsTargeting>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSource>true</IncludeSource>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'SignedRelease|AnyCPU'">
    <OutputPath>bin\SignedRelease\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <NoStdLib>true</NoStdLib>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="publish\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="publish\**" />
    <Page Remove="publish\**" />
  </ItemGroup>
  <!-- Exclude Windows-only files when building for non-Windows targets -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <!-- ASCOM COM driver files (depend on ASCOM.Com.Components) -->
    <Compile Remove="Equipment\AscomDevice.cs" />
    <Compile Remove="Equipment\AscomLogger.cs" />
    <Compile Remove="Equipment\MyCamera\AscomCamera.cs" />
    <Compile Remove="Equipment\MyDome\AscomDome.cs" />
    <Compile Remove="Equipment\MyFilterWheel\AscomFilterWheel.cs" />
    <Compile Remove="Equipment\MyFlatDevice\AscomCoverCalibrator.cs" />
    <Compile Remove="Equipment\MyFocuser\AscomFocuser.cs" />
    <Compile Remove="Equipment\MyRotator\AscomRotator.cs" />
    <Compile Remove="Equipment\MySafetyMonitor\AscomSafetyMonitor.cs" />
    <Compile Remove="Equipment\MySwitch\Ascom\**" />
    <Compile Remove="Equipment\MyTelescope\AscomTelescope.cs" />
    <Compile Remove="Equipment\MyWeatherData\AscomObservingConditions.cs" />
    <!-- Nikon SDK files (depend on nikoncswrapper) -->
    <Compile Remove="Equipment\MyCamera\NikonCamera.cs" />
    <!-- MGEN files (depend on NINA.MGEN) -->
    <Compile Remove="Equipment\MyGuider\MGENGuider.cs" />
    <!-- Moravian camera (depends on System.Windows.Interop) -->
    <Compile Remove="Equipment\MyCamera\MoravianCamera.cs" />
    <Compile Remove="SDK\CameraSDKs\MoravianSDK\MoravianCameraProvider.cs" />
    <Compile Remove="SDK\CameraSDKs\MoravianSDK\MoravianFilterWheelProvider.cs" />
    <Compile Remove="SDK\CameraSDKs\MoravianSDK\MoravianCameraProvider.cs" />
    <Compile Remove="SDK\CameraSDKs\MoravianSDK\MoravianFilterWheelProvider.cs" />
    <!-- WPF Converters -->
    <Compile Remove="Converter\**" />
    <!-- AlpacaDirect files (inherit from Ascom* classes) -->
    <Compile Remove="Equipment\MyCamera\AlpacaDirectCamera.cs" />
    <Compile Remove="Equipment\MyDome\AlpacaDirectDome.cs" />
    <Compile Remove="Equipment\MyFilterWheel\AlpacaDirectFilterWheel.cs" />
    <Compile Remove="Equipment\MyFlatDevice\AlpacaDirectCoverCalibrator.cs" />
    <Compile Remove="Equipment\MyFocuser\AlpacaDirectFocuser.cs" />
    <Compile Remove="Equipment\MyRotator\AlpacaDirectRotator.cs" />
    <Compile Remove="Equipment\MySafetyMonitor\AlpacaDirectSafetyMonitor.cs" />
    <Compile Remove="Equipment\MySwitch\AlpacaDirectSwitch.cs" />
    <Compile Remove="Equipment\MyTelescope\AlpacaDirectTelescope.cs" />
    <Compile Remove="Equipment\MyWeatherData\AlpacaDirectObservingConditions.cs" />
    <!-- Moravian integrated filter wheel (depends on MoravianCamera) -->
    <Compile Remove="Equipment\MyFilterWheel\MoravianIntegratedFilterWheel.cs" />
    <!-- AlpacaDirect settings (depends on ASCOM types) -->
    <Compile Remove="Equipment\AlpacaDirectSettings.cs" />
    <!-- ASCOM/Alpaca utility files -->
    <Compile Remove="Utility\ASCOMInteraction.cs" />
    <Compile Remove="Utility\AlpacaInteraction.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\CommonAssemblyInfo.cs">
      <Link>Properties\CommonAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\nikoncswrapper\nikoncswrapper.csproj" Condition="'$(TargetFramework)' == 'net10.0-windows'" />
    <ProjectReference Include="..\NINA.Astrometry\NINA.Astrometry.csproj" />
    <ProjectReference Include="..\NINA.Core\NINA.Core.csproj" />
    <ProjectReference Include="..\NINA.Image\NINA.Image.csproj" />
    <ProjectReference Include="..\NINA.MGEN\NINA.MGEN.csproj" Condition="'$(TargetFramework)' == 'net10.0-windows'" />
    <ProjectReference Include="..\NINA.Profile\NINA.Profile.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\NINA\Resources\ninasplash.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Service Include="{508349B6-6B84-4DF5-91F0-309BEEBAD82D}" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ASCOM.Alpaca.Components" Version="3.0.0" />
    <PackageReference Include="ASCOM.Alpaca.Device" Version="3.0.0" />
    <PackageReference Include="ASCOM.Com.Components" Version="3.0.0" />
    <PackageReference Include="Castle.Core" Version="5.2.1" />
    <PackageReference Include="Castle.Core.AsyncInterceptor" Version="2.1.0" />
    <PackageReference Include="Google.Protobuf.Tools" Version="3.33.4" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="GrpcDotNetNamedPipes" Version="3.1.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NJsonSchema" Version="11.5.2" />
    <PackageReference Include="SharpGIS.NmeaParser" Version="2.2.2" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="SDK\CameraSDKs\ToupTekAlike\SVBonySDK\" />
  </ItemGroup>
  <PropertyGroup>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>$(AssemblyName)</Title>
    <Version>3.3.0.1016-nightly</Version>
    <Authors>Stefan Berg and the N.I.N.A. Contributors</Authors>
    <Product>N.I.N.A. - Nighttime Imaging 'N' Astronomy</Product>
    <Description>This assembly contains the Equipment components of N.I.N.A. to interact and connect to various types of astronomy equipment.</Description>
    <Copyright>Copyright ©  2016 - 2026 Stefan Berg and the N.I.N.A. contributors</Copyright>
    <PackageIcon>ninasplash.png</PackageIcon>
    <PackageProjectUrl>https://nighttime-imaging.eu/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/isbeorn/nina.git</RepositoryUrl>
    <PackageOutputPath>$(SolutionDir)publish</PackageOutputPath>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec IgnoreExitCode="true" Command="   if $(Configuration) == SignedRelease signtool sign /t http://timestamp.sectigo.com /i Sectigo /v /a /fd SHA256 $(TargetPath)" />
  </Target>
</Project>
