[Unit]
Description=NINA Headless - Beyond Stellar Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nina
Group=nina
WorkingDirectory=/opt/nina-headless
ExecStart=/opt/nina-headless/NINA.Headless
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nina-headless
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://0.0.0.0:1888
# Allow binding to port 1888 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
