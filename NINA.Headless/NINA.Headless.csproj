<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- RuntimeIdentifier specified at publish time. Production: linux-x64 / linux-arm64
         (USB appliance). Dev: osx-x64 / osx-arm64. -->
    <SelfContained>false</SelfContained>
    <AssemblyName>NINA.Headless</AssemblyName>
    <RootNamespace>NINA.Headless</RootNamespace>
    <Platforms>AnyCPU</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.*" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.1" />
    <PackageReference Include="SIPSorcery" Version="8.0.*" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NINA.Core\NINA.Core.csproj" />
    <ProjectReference Include="..\NINA.Equipment\NINA.Equipment.csproj" />
    <ProjectReference Include="..\NINA.Astrometry\NINA.Astrometry.csproj" />
    <ProjectReference Include="..\NINA.Image\NINA.Image.csproj" />
    <ProjectReference Include="..\NINA.Profile\NINA.Profile.csproj" />
    <ProjectReference Include="..\NINA.Platesolving\NINA.PlateSolving.csproj" />
    <ProjectReference Include="..\NINA.Sequencer\NINA.Sequencer.csproj" />
    <ProjectReference Include="..\NINA.Headless.Mediator\NINA.Headless.Mediator.csproj" />
  </ItemGroup>
</Project>
